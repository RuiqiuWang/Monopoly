#!/usr/bin/env bash

set -u
set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PYTHON:-python3}"
MAKE_BIN="${MAKE:-make}"
CC_BIN="${CC:-cc}"
CC_CHECK="${CC_BIN%% *}"
CPPFLAGS_VALUE="${CPPFLAGS:--Iinclude}"
CFLAGS_VALUE="${CFLAGS:--std=c11 -Wall -Wextra -Wpedantic}"
LOG_FILE="$(mktemp)"

cleanup() {
    rm -f "$LOG_FILE"
}
trap cleanup EXIT

print_header() {
    printf '%s\n' "MONOPOLY automated environment/build/test runner"
    printf '%s\n' "Project: $ROOT"
    printf '%s\n\n' "Mode: dependency check -> build -> test"
}

pass_line() {
    printf '[PASS]\n'
}

fail_line() {
    printf '[FAIL]\n'
    if [ -s "$LOG_FILE" ]; then
        printf '%s\n' "---- command output ----"
        sed -n '1,220p' "$LOG_FILE"
        printf '%s\n' "------------------------"
    fi
}

run_check() {
    local current="$1"
    local total="$2"
    local label="$3"
    local command_name="$4"

    : > "$LOG_FILE"
    printf '[%d/%d] Checking %s using command -v ... ' "$current" "$total" "$label"
    if command -v "$command_name" >"$LOG_FILE" 2>&1; then
        pass_line
    else
        fail_line
        printf 'Missing dependency: %s\n' "$command_name"
        exit 1
    fi
}

run_optional_make_check() {
    local current="$1"
    local total="$2"

    : > "$LOG_FILE"
    printf '[%d/%d] Checking make using command -v ... ' "$current" "$total"
    if command -v "$MAKE_BIN" >"$LOG_FILE" 2>&1; then
        pass_line
    else
        printf '[SKIP]\n'
        printf '%s\n' "make not found; direct compiler fallback will be used."
    fi
}

run_project_check() {
    local current="$1"
    local total="$2"

    : > "$LOG_FILE"
    printf '[%d/%d] Checking project layout using filesystem ... ' "$current" "$total"
    if [ -f "$ROOT/Makefile" ] &&
       [ -f "$ROOT/movement.c" ] &&
       [ -f "$ROOT/tests/run_json_tests.py" ] &&
       [ -d "$ROOT/tests/input" ]; then
        pass_line
    else
        {
            printf 'Required project files were not found under %s\n' "$ROOT"
            printf 'Expected Makefile, movement.c, tests/run_json_tests.py, tests/input\n'
        } > "$LOG_FILE"
        fail_line
        exit 1
    fi
}

run_build() {
    local current="$1"
    local total="$2"
    local target="$3"

    : > "$LOG_FILE"
    if command -v "$MAKE_BIN" > /dev/null 2>&1; then
        printf '[%d/%d] Building %s using %s ... ' "$current" "$total" "$target" "$MAKE_BIN"
        if "$MAKE_BIN" -C "$ROOT" "$target" >"$LOG_FILE" 2>&1; then
            pass_line
        else
            fail_line
            exit 1
        fi
        return
    fi

    printf '[%d/%d] Building %s using %s fallback ... ' "$current" "$total" "$target" "$CC_CHECK"
    (
        cd "$ROOT" || exit 1
        case "$target" in
            clean)
                rm -f test_movement test_movement.exe \
                      movement_cli movement_cli.exe \
                      character_select_cli character_select_cli.exe \
                      character_select_test character_select_test.exe \
                      map_test map_test.exe \
                      item_usage_test item_usage_test.exe \
                      item_effect_test item_effect_test.exe \
                      fortune_test fortune_test.exe \
                      gift_house_test gift_house_test.exe \
                      help_query_test help_query_test.exe \
                      property_test property_test.exe \
                      mine_test mine_test.exe \
                      tool_room_test tool_room_test.exe \
                      assets_test assets_test.exe \
                      game_engine game_engine.exe
                ;;
            test_movement)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE movement.c tests/test_movement.c -o test_movement
                ;;
            movement_cli)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE movement.c tests/movement_cli.c -o movement_cli
                ;;
            character_select_cli)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE character_select.c input.c character_select_cli.c -o character_select_cli
                ;;
            game_engine)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE game_engine.c command.c tutorial.c map.c tui.c movement.c mine.c tool_room.c assets.c player.c character_select.c input.c item_usage.c item_effect.c fortune.c gift_house.c help_query.c property.c -o game_engine
                ;;
            tutorial_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE tutorial.c input.c tui.c map.c movement.c tests/test_tutorial.c -o tutorial_test
                ;;
            command_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE command.c tests/test_command.c -o command_test
                ;;
            mine_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE mine.c map.c player.c tests/test_mine.c -o mine_test
                ;;
            tool_room_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE tool_room.c input.c player.c tests/test_tool_room.c -o tool_room_test
                ;;
            assets_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE assets.c map.c player.c tests/test_assets.c -o assets_test
                ;;
            character_select_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE character_select.c input.c tests/test_character_select.c -o character_select_test
                ;;
            map_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE map.c tests/test_map.c -o map_test
                ;;
            item_usage_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE item_usage.c map.c tests/test_item_usage.c -o item_usage_test
                ;;
            item_effect_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE item_effect.c movement.c map.c tests/test_item_effect.c -o item_effect_test
                ;;
            fortune_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE fortune.c property.c map.c player.c tests/test_fortune.c -o fortune_test
                ;;
            gift_house_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE gift_house.c input.c tests/test_gift_house.c -o gift_house_test
                ;;
            help_query_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE help_query.c tests/test_help_query.c -o help_query_test
                ;;
            property_test)
                $CC_BIN $CPPFLAGS_VALUE $CFLAGS_VALUE property.c map.c tests/test_property.c -o property_test
                ;;
            *)
                printf 'No fallback build rule for %s\n' "$target"
                exit 1
                ;;
        esac
    ) >"$LOG_FILE" 2>&1
    if [ "$?" -eq 0 ]; then
        pass_line
    else
        fail_line
        exit 1
    fi
}

run_test_command() {
    local current="$1"
    local total="$2"
    local label="$3"
    shift 3

    : > "$LOG_FILE"
    printf '[%d/%d] Running Test %s ... ' "$current" "$total" "$label"
    if "$@" >"$LOG_FILE" 2>&1; then
        pass_line
    else
        fail_line
        exit 1
    fi
}

run_json_suite() {
    "$PYTHON_BIN" "$ROOT/tests/validate_json_testcases.py" &&
        "$PYTHON_BIN" "$ROOT/tests/run_json_tests.py"
}

main() {
    local env_total=4
    local build_total=18
    local test_total
    local step=1

    print_header

    run_project_check 1 "$env_total"
    run_check 2 "$env_total" "C compiler" "$CC_CHECK"
    run_optional_make_check 3 "$env_total"
    run_check 4 "$env_total" "python3" "$PYTHON_BIN"
    printf '\n'

    run_build 1 "$build_total" "clean"
    run_build 2 "$build_total" "test_movement"
    run_build 3 "$build_total" "movement_cli"
    run_build 4 "$build_total" "tutorial_test"
    run_build 5 "$build_total" "command_test"
    run_build 6 "$build_total" "mine_test"
    run_build 7 "$build_total" "tool_room_test"
    run_build 8 "$build_total" "assets_test"
    run_build 9 "$build_total" "character_select_cli"
    run_build 10 "$build_total" "character_select_test"
    run_build 11 "$build_total" "map_test"
    run_build 12 "$build_total" "item_usage_test"
    run_build 13 "$build_total" "item_effect_test"
    run_build 14 "$build_total" "fortune_test"
    run_build 15 "$build_total" "gift_house_test"
    run_build 16 "$build_total" "help_query_test"
    run_build 17 "$build_total" "property_test"
    run_build 18 "$build_total" "game_engine"
    printf '\n'

    test_total=16
    run_test_command "$step" "$test_total" "movement unit" "$ROOT/test_movement"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "tutorial choice unit" "$ROOT/tutorial_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "command unit" "$ROOT/command_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "mine unit" "$ROOT/mine_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "tool room unit" "$ROOT/tool_room_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "assets unit" "$ROOT/assets_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "character select unit" "$ROOT/character_select_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "map property unit" "$ROOT/map_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "item usage unit" "$ROOT/item_usage_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "item effect unit" "$ROOT/item_effect_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "fortune unit" "$ROOT/fortune_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "gift house unit" "$ROOT/gift_house_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "help query unit" "$ROOT/help_query_test"
    step=$((step + 1))
    run_test_command "$step" "$test_total" "property unit" "$ROOT/property_test"
    step=$((step + 1))

    run_test_command "$step" "$test_total" "JSON schema 2.0 suite" run_json_suite
    step=$((step + 1))

    run_test_command "$step" "$test_total" "game engine end-to-end" "$PYTHON_BIN" "$ROOT/tests/e2e_game.py"

    printf '\nAll checks passed: %d build steps, %d tests.\n' "$build_total" "$test_total"
}

main "$@"
